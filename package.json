{
  "name": "@algoryq/learn-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "claims:check": "tsx scripts/claims-check.ts",
    "links:check": "tsx scripts/links-check.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm claims:check && pnpm build && pnpm lint && pnpm links:check",
    "sync:catalog": "tsx scripts/sync-catalog.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.0",
      "brace-expansion": ">=5.0.8",
      "postcss": ">=8.5.18",
      "vite": ">=6.4.3"
    }
  }
}
