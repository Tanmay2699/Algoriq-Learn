# The public origin. Canonicals, sitemap, OG URLs. A production deployment REFUSES to build
# without it (see src/config/site.ts).
SITE_URL=https://akechi.com

# Where the product lives. "Sign in" points here; this site never authenticates anyone.
APP_URL=https://app.akechi.com

# The read-only demo institute. Opened in a new tab from every sandbox CTA.
SANDBOX_URL=https://sandbox.akechi.com

# The product API. /api/lead and /api/plans are the only things that call it.
# Use 127.0.0.1 rather than localhost — IPv6 resolution breaks container access.
API_URL=http://127.0.0.1:4000

# Our own tenant on our own product: where an enquiry from /demo lands.
AKECHI_TENANT_SLUG=akechi

# Set by the production pipeline. Turns the SITE_URL check from a warning into a failure.
# DEPLOY_ENV=production
